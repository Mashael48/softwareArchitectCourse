@startuml containers
!include <C4/C4_Container>
title Hajj Permit (Vehicles) - Container Diagram (C4 Level 2, Course Implementation)
LAYOUT_WITH_LEGEND()
Person(moroor, "Moroor", "Moroor users who process inventory requests")
Person(entities, "Entities", "Entity users who request inventory and issue permits")
System_Ext(notification, "Notification", "Sends SMS notifications")
System_Ext(tawakkalna, "Tawakkalna", "Displays digital permits and synchronizes them with the digital wallet")
System_Ext(nic, "NIC", "Validates and verifies vehicle permits")
System_Boundary(hajj_permit_core, "Hajj Permit Core") {
Container(gateway, "Backend Gateway", "Node.js / Express", "Provides a single entry point for backend APIs and routes requests to the appropriate service")
Container(entity_service, "Entity Service", "Node.js / Express", "Handles entity management")
Container(inventory_service, "Inventory Service", "Node.js / Express", "Handles inventory requests, allocation management, and processing locks")
Container(permit_service, "Permit Service", "Node.js / Express", "Handles permit issuance, viewing, and permit-related operations")
Container(notification_service, "Notification Service", "Node.js / Express", "Handles system notifications")
ContainerDb(redis, "Redis", "Redis", "Stores temporary inventory request processing locks")
}
Rel(moroor, gateway, "Processes inventory requests", "HTTP / JSON")
Rel(entities, gateway, "Requests and views inventory, and issues permits", "HTTP / JSON")
Rel(gateway, entity_service, "Routes entity requests", "HTTP / JSON")
Rel(gateway, inventory_service, "Routes inventory requests", "HTTP / JSON")
Rel(gateway, permit_service, "Routes permit requests", "HTTP / JSON")
Rel(inventory_service, notification_service, "Requests notifications", "HTTP / JSON")
Rel(permit_service, notification_service, "Requests notifications", "HTTP / JSON")
Rel(permit_service, inventory_service, "Checks and consumes permit inventory", "HTTP / JSON")
Rel(inventory_service, redis, "Tracks inventory requests currently under processing", "Redis Protocol")
Rel(notification_service, notification, "Sends SMS notifications", "HTTPS")
Rel(permit_service, tawakkalna, "Sends permit information for digital wallet synchronization", "HTTPS")
Rel(permit_service, nic, "Validates and verifies vehicle permits", "HTTPS")
@enduml