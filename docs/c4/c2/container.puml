@startuml containers
!include <C4/C4_Container>
title Hajj Permit (Vehicles) - Container Diagram (C4 Level 2, As-Is)
LAYOUT_WITH_LEGEND()
Person(moroor, "Moroor", "Moroor users who process inventory requests")
Person(entities, "Entities", "Entity users who request inventory and issue permits")
System_Ext(notification, "Notification", "Sends SMS notifications")
System_Ext(tawakkalna, "Tawakkalna", "Displays digital permits and synchronizes them with the digital wallet")
System_Ext(nic, "NIC", "Validates and verifies vehicle permits")
System_Boundary(hajj_permit_core, "Hajj Permit Core") {
Container(web_app, "Hajj Permit Web App", "Angular", "Provides the user interface for Moroor and entities")
Container(gateway, "Backend Gateway", "Spring Boot", "Provides a single entry point for backend APIs and routes requests to the appropriate service")
Container(entity_service, "Entity Service", "Spring Boot", "Handles entity management")
Container(inventory_service, "Inventory Service", "Spring Boot", "Handles inventory requests and allocation management")
Container(permit_service, "Permit Service", "Spring Boot", "Handles permit issuance, viewing, and permit-related operations")
Container(notification_service, "Notification Service", "Spring Boot", "Handles system notifications")
ContainerDb(redis, "Redis", "Cache", "Stores temporary inventory data")
ContainerDb(hajj_permit_db, "Hajj Permit Database", "SQL Server", "Stores entities, inventory, requests, and permit data")
}
Rel(moroor, web_app, "Processes inventory requests", "HTTPS")
Rel(entities, web_app, "Requests and views inventory, and issues permits", "HTTPS")
Rel(web_app, gateway, "Calls backend APIs", "HTTPS / JSON")
Rel(gateway, entity_service, "Routes entity requests", "HTTPS")
Rel(gateway, inventory_service, "Routes inventory requests", "HTTPS")
Rel(gateway, permit_service, "Routes permit requests", "HTTPS")
Rel(entity_service, notification_service, "Requests notifications", "HTTPS")
Rel(inventory_service, notification_service, "Requests notifications", "HTTPS")
Rel(permit_service, notification_service, "Requests notifications", "HTTPS")
Rel(inventory_service, redis, "Reads and writes cached inventory data", "Redis Protocol")
Rel(notification_service, notification, "Sends SMS notifications", "HTTPS")
Rel(entity_service, hajj_permit_db, "Reads and writes entity data", "SQL")
Rel(inventory_service, hajj_permit_db, "Reads and writes inventory request data", "SQL")
Rel(permit_service, hajj_permit_db, "Reads and writes permit data", "SQL")
Rel(permit_service, tawakkalna, "Sends permit information for digital wallet synchronization", "HTTPS")
Rel(permit_service, nic, "Validates and verifies vehicle permits", "HTTPS")
@enduml