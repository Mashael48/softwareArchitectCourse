@startuml context
!include <C4/C4_Context>
title Hajj Permit (Vehicles) - System Context (C4 Level 1)
LAYOUT_WITH_LEGEND()
Person(moroor, "Moroor", "Moroor users who process inventory requests")
Person(entities, "Entities", "Entity users who request inventory and issue permits")
System(hajj_permit_core, "Hajj Permit Core", "The 2022 system for inventory management, entity management, and permit management")
System_Ext(notification, "Notification", "Sends SMS notifications")
System_Ext(tawakkalna, "Tawakkalna", "Displays digital permits and synchronizes them with the digital wallet")
System_Ext(nic, "NIC", "Validates and verifies vehicle permits")
Rel(moroor, hajj_permit_core, "Processes inventory requests")
Rel(entities, hajj_permit_core, "Requests and views inventory, and issues permits")
Rel(hajj_permit_core, notification, "Sends SMS notifications to entities", "HTTPS")
Rel(hajj_permit_core, tawakkalna, "Sends permit information for digital wallet synchronization", "HTTPS")
Rel(hajj_permit_core, nic, "Validates vehicle permits", "HTTPS")
@enduml